    "Double-tap Add Take in the toolbar. To save, double-tap Save and close. That's the whole capture flow." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe in der Symbolleiste doppelt auf „Take hinzufügen“. Zum Speichern tippe doppelt auf „Speichern und schließen“. Das ist der gesamte Erfassungsablauf."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-cliquez sur Ajouter un Take dans la barre d’outils. Pour enregistrer, double-cliquez sur Enregistrer et fermer. C’est tout le processus de capture."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dos veces Añadir Take en la barra de herramientas. Para guardar, toca dos veces Guardar y cerrar. Eso es todo el flujo de captura."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca due volte Aggiungi Take nella barra degli strumenti. Per salvare, tocca due volte Salva e chiudi. È tutto qui il flusso di acquisizione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque duas vezes em Adicionar Take na barra de ferramentas. Para salvar, toque duas vezes em Salvar e fechar. Esse é todo o fluxo de captura."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dubbeltik op Take toevoegen in de werkbalk. Dubbeltik op Opslaan en sluiten om op te slaan. Zo leg je iets vast."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque duas vezes em Adicionar Take na barra de ferramentas. Para guardar, toque duas vezes em Guardar e fechar. Esse é todo o fluxo de captura."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij dwukrotnie „Dodaj Take” na pasku narzędzi. Aby zapisać, kliknij dwukrotnie „Zapisz i zamknij”. To cały proces przechwytywania."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dubbeltryck på Lägg till Take i verktygsfältet. Spara genom att dubbeltrycka på Spara och stäng. Så går hela skapandet till."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobbelttryk på Tilføj Take på værktøjslinjen. Du gemmer ved at dobbelttrykke på Gem og luk. Sådan foregår hele optagelsen."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobbelttrykk på «Legg til Take» på verktøylinjen. Dobbelttrykk på «Lagre og lukk» for å lagre. Det er hele opptaksflyten."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dubbeltik op Take toevoegen in de werkbalk. Dubbeltik op Opslaan en sluiten om op te slaan. Dat is het hele vastleggingsproces."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Araç çubuğundaki Take Ekle'ye çift dokunun. Kaydetmek için Kaydet ve kapat'a çift dokunun. Tüm yakalama akışı budur."
          }
        }
      }
    },
    "Double-tap an Iris to make that Take a task, set a reminder, or make it important." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe doppelt auf eine Iris, um diesen Take in eine Aufgabe zu verwandeln, eine Erinnerung festzulegen oder ihn als wichtig zu markieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-cliquez sur un Iris pour transformer ce Take en tâche, définir un rappel ou le marquer comme important."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dos veces un Iris para convertir ese Take en una tarea, programar un recordatorio o marcarlo como importante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca due volte un Iris per trasformare quel Take in un'attività, impostare un promemoria o contrassegnarlo come importante."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque duas vezes em um Iris para transformar esse Take em tarefa, definir um lembrete ou marcá-lo como importante."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dubbeltik op een Iris om van die Take een taak te maken, een herinnering in te stellen of de Take belangrijk te maken."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca duas vezes num Iris para transformar esse Take numa tarefa, definir um lembrete ou marcá-lo como importante."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
