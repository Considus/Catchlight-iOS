    "Never syncs. Your Takes stay on this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird nie synchronisiert. Deine Takes bleiben auf diesem Gerät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne se synchronise jamais. Vos Takes restent sur cet appareil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca se sincroniza. Tus Takes permanecen en este dispositivo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non sincronizza mai. I tuoi Take rimangono su questo dispositivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca sincroniza. Seus Takes ficam neste dispositivo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt nooit gesynchroniseerd. Je Takes blijven op dit apparaat."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca sincroniza. Os seus Takes ficam neste dispositivo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nigdy nie synchronizuje. Twoje Takes pozostają na tym urządzeniu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkroniseras aldrig. Dina Takes finns kvar på den här enheten."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkroniserer aldrig. Dine Takes forbliver på denne enhed."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkroniseres aldri. Take-ene dine blir værende på denne enheten."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei synkronoidu koskaan. Taket pysyvät tällä laitteella."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asla senkronize edilmez. Take'leriniz bu cihazda kalır."
          }
        }
      }
    },
