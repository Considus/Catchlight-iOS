    "Keeping it replaces any newer edit that may exist on another device when it syncs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du sie behältst, werden beim Synchronisieren neuere Änderungen auf einem anderen Gerät ersetzt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conserver remplacera toute modification plus récente qui pourrait se trouver sur un autre appareil lors de la synchronisation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al conservarla, se sustituirá cualquier edición más reciente que exista en otro dispositivo al sincronizar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenendo questa versione sostituirai qualsiasi modifica più recente presente su un altro dispositivo al momento della sincronizzazione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao mantê-la, você substituirá qualquer edição mais recente que possa existir em outro dispositivo quando ele sincronizar."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je deze versie behoudt, vervangt die bij de synchronisatie een nieuwere bewerking die mogelijk op een ander apparaat staat."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao mantê-la, substituirá qualquer edição mais recente que possa existir noutro dispositivo quando este sincronizar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowanie jej zastąpi podczas synchronizacji wszelkie nowsze edycje, które mogą istnieć na innym urządzeniu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du behåller den ersätter den alla nyare ändringar som kan finnas på en annan enhet när den synkroniseras."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du beholder den, erstatter den eventuelle nyere redigeringer, der måtte eksistere på en anden enhed, når den synkroniseres."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når den synkroniseres, erstatter dette eventuelle nyere endringer som kan finnes på en annen enhet."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen säilyttäminen korvaa mahdolliset uudemmat muokkaukset toisella laitteella, kun laitteet synkronoidaan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu korumak, eşitlendiğinde başka bir cihazda bulunabilecek daha yeni düzenlemelerin üzerine yazar."
          }
        }
      }
    },
