          }
        }
      }
    },
    "Authenticate with Face ID or your device passcode to view the 12 words. They're the only way to recover your account, so reveal them somewhere private." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authentifiziere dich mit Face ID oder deinem Geräte-Code, um die 12 Wörter anzuzeigen. Sie sind die einzige Möglichkeit, deinen Account wiederherzustellen, zeige sie daher nur an einem privaten Ort an."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authentifiez-vous avec Face ID ou le code de votre appareil pour voir les 12 mots. Ils sont le seul moyen de récupérer votre compte, alors affichez-les dans un endroit privé."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autentícate con Face ID o con el código de tu dispositivo para ver las 12 palabras. Son la única forma de recuperar tu cuenta, así que muéstralas en un lugar privado."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autenticati con Face ID o con il codice del dispositivo per visualizzare le 12 parole. Sono l'unico modo per recuperare il tuo account, quindi mostrale in un luogo sicuro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autentique-se com o Face ID ou o código de acesso do dispositivo para ver as 12 palavras. Elas são a única forma de recuperar sua conta, então revele-as em um lugar privado."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifieer je identiteit met Face ID of de toegangscode van je apparaat om de 12 woorden te bekijken. Dat is de enige manier om je account te herstellen, dus toon ze op een privéplek."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autentique-se com o Face ID ou com o código do dispositivo para ver as 12 palavras. São a única forma de recuperar a sua conta, pelo que deve revelá-las num local privado."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uwierzytelnij się za pomocą Face ID lub kodu urządzenia, aby zobaczyć 12 słów. To jedyny sposób na odzyskanie konta, więc ujawnij je w prywatnym miejscu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autentisera med Face ID eller enhetens lösenkod för att visa de 12 orden. De är det enda sättet att återställa kontot, så visa dem på en privat plats."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godkend dig med Face ID eller din enheds adgangskode for at se de 12 ord. De er den eneste måde at gendanne din konto på, så vis dem et privat sted."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autentiser med Face ID eller enhetens kode for å se de 12 ordene. De er den eneste måten å gjenopprette kontoen din på, så vis dem et privat sted."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifieer je identiteit met Face ID of de toegangscode van je apparaat om de 12 woorden te bekijken. Alleen daarmee kun je je account herstellen, dus bekijk ze op een privéplek."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
