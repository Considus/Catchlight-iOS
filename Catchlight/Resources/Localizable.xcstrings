    },
    "Encrypted on this device, readable only by you. To finish setting up cloud backup, choose your folder in Settings → System → Cloud Storage." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Gerät verschlüsselt, nur für dich lesbar. Um die Cloud-Sicherung abzuschließen, wähle deinen Ordner unter Einstellungen → System → Cloud-Speicher."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiffré sur cet appareil, lisible uniquement par vous. Pour terminer la configuration de la sauvegarde cloud, choisissez votre dossier dans Réglages → Système → Stockage cloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cifrado en este dispositivo y legible solo por ti. Para terminar de configurar la copia en la nube, elige tu carpeta en Ajustes → Sistema → Almacenamiento en la nube."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crittografato su questo dispositivo, leggibile solo da te. Per completare la configurazione del backup cloud, scegli la cartella in Impostazioni → Sistema → Archiviazione cloud."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Criptografado neste dispositivo, legível só por você. Para concluir a configuração do backup na nuvem, escolha sua pasta em Ajustes → Sistema → Armazenamento na nuvem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versleuteld op dit apparaat, alleen leesbaar voor jou. Kies je map in Instellingen → Systeem → Cloudopslag om de cloudreservekopie verder in te stellen."
          }
        }
      }
    },
    "Enter your Privacy phrase" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib deine Datenschutz-Phrase ein"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez votre phrase de confidentialité"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce tu frase de privacidad"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci la tua frase di privacy"
          }
        },
        "pt-BR" : {
