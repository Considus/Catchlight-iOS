          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godkend dig selv for at åbne dine Takes."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autentiser for å åpne Take-ene dine."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
