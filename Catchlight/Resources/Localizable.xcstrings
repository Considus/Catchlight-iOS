    "A tighter radius is more precise, but iOS may trigger it late or miss it. 100 m is the reliable minimum." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein kleinerer Radius ist präziser, aber iOS löst möglicherweise zu spät oder gar nicht aus. 100 m ist das verlässliche Minimum."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rayon plus serré est plus précis, mais iOS peut le déclencher en retard ou le manquer. 100 m est le minimum fiable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un radio más pequeño es más preciso, pero iOS podría activarlo tarde o pasarlo por alto. 100 m es el mínimo confiable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un raggio più stretto è più preciso, ma iOS potrebbe attivarlo in ritardo o non rilevarlo. 100 m è il minimo affidabile."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um raio menor é mais preciso, mas o iOS pode ativar o lembrete com atraso ou não ativá-lo. 100 m é a distância mínima confiável."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een kleinere straal is nauwkeuriger, maar iOS kan de melding te laat geven of helemaal missen. 100 m is de betrouwbare minimumafstand."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um raio mais reduzido é mais preciso, mas o iOS pode ativá-lo com atraso ou falhar. 100 m é o mínimo fiável."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mniejszy promień jest bardziej precyzyjny, ale iOS może go uruchomić z opóźnieniem lub go pominąć. 100 m to niezawodne minimum."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En mindre radie är mer precis, men iOS kan utlösa den för sent eller missa den. 100 m är det minsta avståndet som fungerar tillförlitligt."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En mindre radius er mere præcis, men iOS kan udløse den for sent eller slet ikke. 100 m er den mindste pålidelige afstand."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En mindre radius er mer presis, men iOS kan utløse den sent eller ikke i det hele tatt. 100 m er den minste pålitelige radiusen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een kleinere straal is nauwkeuriger, maar iOS kan de melding laat geven of helemaal missen. 100 m is de kleinste betrouwbare afstand."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha dar bir yarıçap daha hassastır, ancak iOS bunu geç tetikleyebilir veya kaçırabilir. 100 m güvenilir minimum mesafedir."
          }
        }
      }
    },
