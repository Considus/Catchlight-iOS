          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naciśnij i przytrzymaj, aby wyświetlić 12 słów. Zwolnij, aby je ukryć."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll ned för att visa de 12 orden. Släpp för att dölja dem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold nede for at vise de 12 ord. Slip for at skjule dem."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
