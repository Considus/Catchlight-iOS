          }
        }
      }
    },
    "The copies of these Takes in your cloud folder didn't pass their check. Nothing changes on this phone until you choose." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kopien dieser Takes in deinem Cloud-Ordner haben die Prüfung nicht bestanden. Auf diesem iPhone ändert sich nichts, bis du entscheidest."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les copies de ces Takes dans votre dossier cloud n’ont pas passé la vérification. Rien ne change sur cet iPhone tant que vous n’avez pas choisi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias de estos Takes en tu carpeta en la nube no han superado la comprobación. No cambiará nada en este iPhone hasta que elijas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le copie di questi Take nella tua cartella cloud non hanno superato la verifica. Su questo telefono non cambia nulla finché non scegli."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As cópias desses Takes na sua pasta na nuvem não passaram na verificação. Nada muda neste iPhone até você escolher."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kopieën van deze Takes in je cloudmap zijn niet door de controle gekomen. Er verandert niets op deze telefoon tot je een keuze maakt."
          }
        }
      }
    },
    "The file is readable text and it does not contain a recovery phrase. Use Start over and Import from a file to re-import your Takes. Delete the export once your Takes are back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei ist lesbarer Text und enthält keine Wiederherstellungsphrase. Nutze „Neu beginnen“ und „Aus Datei importieren“, um deine Takes wieder zu importieren. Lösche den Export, sobald deine Takes zurück sind."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier est du texte lisible et ne contient pas de phrase de récupération. Utilisez « Recommencer » puis « Importer depuis un fichier » pour réimporter vos Takes. Supprimez l’export une fois vos Takes récupérés."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo es texto legible y no contiene ninguna frase de recuperación. Usa “Empezar de nuevo” e “Importar desde un archivo” para volver a importar tus Takes. Elimina la exportación cuando hayas recuperado tus Takes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il file è testo leggibile e non contiene una frase di recupero. Usa “Ricomincia” e “Importa da un file” per reimportare i tuoi Take. Elimina il file esportato quando i Take sono tornati."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo é texto legível e não contém uma frase de recuperação. Use “Recomeçar” e depois “Importar de um arquivo” para reimportar seus Takes. Apague a exportação quando seus Takes estiverem de volta."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het bestand is leesbare tekst en bevat geen herstelzin. Gebruik ‘Begin opnieuw’ en ‘Importeer uit een bestand’ om je Takes opnieuw te importeren. Verwijder de export zodra je Takes terug zijn."
          }
        }
      }
    },
    "The Import folder couldn't be read. Check your cloud folder in Settings → Cloud Storage and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ordner „Import“ konnte nicht gelesen werden. Prüfe deinen Cloud-Ordner unter Einstellungen → Cloud-Speicher und versuche es erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire le dossier Import. Vérifiez votre dossier cloud dans Réglages → Stockage cloud et réessayez."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido leer la carpeta Import. Comprueba tu carpeta en la nube en Ajustes → Almacenamiento en la nube e inténtalo de nuevo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere la cartella Import. Controlla la cartella cloud in Impostazioni → Archiviazione cloud e riprova."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler a pasta Import. Verifique sua pasta na nuvem em Ajustes → Armazenamento na nuvem e tente novamente."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De map Import kan niet worden gelezen. Controleer je cloudmap in Instellingen → Cloudopslag en probeer het opnieuw."
          }
        }
      }
    },
    "The newer version from another device can't be read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die neuere Version von einem anderen Gerät ist nicht lesbar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version plus récente provenant d’un autre appareil est illisible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede leer la versión más reciente de otro dispositivo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La versione più recente proveniente da un altro dispositivo non è leggibile."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível ler a versão mais recente vinda de outro dispositivo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De nieuwere versie van een ander apparaat kan niet worden gelezen."
          }
        }
      }
    },
    "These Takes may have been edited on different devices, so we can't resolve which to keep. Tap on the version you'd like to remain. The other will be removed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Takes wurden möglicherweise auf verschiedenen Geräten bearbeitet, daher können wir nicht entscheiden, welche Version bleibt. Tippe auf die Version, die du behalten möchtest. Die andere wird entfernt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces Takes ont peut-être été modifiés sur différents appareils : nous ne pouvons donc pas déterminer lequel garder. Touchez la version que vous souhaitez conserver. L’autre sera supprimée."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que estos Takes se hayan editado en distintos dispositivos, así que no podemos decidir cuál conservar. Toca la versión que quieras mantener. La otra se eliminará."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi Take potrebbero essere stati modificati su dispositivi diversi, quindi non possiamo stabilire quale mantenere. Tocca la versione che vuoi tenere. L’altra verrà rimossa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esses Takes podem ter sido editados em dispositivos diferentes, então não conseguimos decidir qual manter. Toque na versão que você quer manter. A outra será removida."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze Takes zijn mogelijk op verschillende apparaten gewijzigd, dus we kunnen niet bepalen welke we moeten behouden. Tik op de versie die je wilt houden. De andere wordt verwijderd."
          }
        }
      }
    },
    "This cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das kann nicht rückgängig gemacht werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action est irréversible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta acción no se puede deshacer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa azione non può essere annullata."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta ação não pode ser desfeita."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit kan niet ongedaan worden gemaakt."
          }
        }
      }
    },
    "This deletes every Take on this device and the Privacy phrase that unlocks them. Takes in your cloud folder will be unreadable. This cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit werden alle Takes auf diesem Gerät gelöscht, ebenso die Datenschutz-Phrase, die sie entsperrt. Takes in deinem Cloud-Ordner werden unlesbar. Das kann nicht rückgängig gemacht werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprime tous les Takes de cet appareil ainsi que la phrase de confidentialité qui les déverrouille. Les Takes de votre dossier cloud deviendront illisibles. Cette action est irréversible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina todos los Takes de este dispositivo y la frase de privacidad que los desbloquea. Los Takes de tu carpeta en la nube no se podrán leer. Esta acción no se puede deshacer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa azione elimina tutti i Take su questo dispositivo e la frase di privacy che li sblocca. I Take nella tua cartella cloud diventeranno illeggibili. Questa azione non può essere annullata."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso apaga todos os Takes deste dispositivo e a frase de privacidade que os desbloqueia. Os Takes na sua pasta na nuvem ficarão ilegíveis. Esta ação não pode ser desfeita."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee verwijder je elke Take op dit apparaat en de privacyzin die ze ontgrendelt. Takes in je cloudmap worden onleesbaar. Dit kan niet ongedaan worden gemaakt."
          }
        }
      }
    },
    "This evening" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute Abend"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce soir"
          }
        },
        "es" : {
