          "stringUnit" : {
            "state" : "translated",
            "value" : "„Fenster“ schlägt vor, du übernimmst. „Direkt“ schreibt an Ort und Stelle um. Beide senden diesen Take an Apple. Deine Datenschutz-Phrase nie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Panneau » propose, vous acceptez. « Intégré » réécrit directement. Les deux envoient ce Take à Apple. Votre phrase de confidentialité, jamais."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Panel” sugiere y tú aceptas. “Integrado” reescribe en el sitio. Ambos envían ese Take a Apple. Tu frase de privacidad, nunca."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Pannello” suggerisce, tu accetti. “In linea” riscrive direttamente nel testo. Entrambi inviano quel Take ad Apple. La tua frase di privacy mai."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Painel” sugere, você aceita. “Integrado” reescreve no próprio texto. Ambos enviam esse Take à Apple. Sua frase de privacidade, nunca."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Paneel’ doet voorstellen, jij accepteert. ‘Inline’ herschrijft ter plekke. Beide sturen die Take naar Apple. Je privacyzin nooit."
          }
        }
      }
    },
