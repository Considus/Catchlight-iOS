    },
    "You can start over and try again. Your phrase hasn't been saved anywhere. We'll generate another." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst von vorn beginnen und es erneut versuchen. Deine Phrase wurde nirgendwo gespeichert. Wir erstellen eine neue."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez recommencer et réessayer. Votre phrase n'a été enregistrée nulle part. Nous en générerons une autre."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes empezar de nuevo e intentarlo otra vez. Tu frase no se ha guardado en ningún sitio. Generaremos otra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi ricominciare e riprovare. La tua frase non è stata salvata da nessuna parte. Ne genereremo un’altra."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode recomeçar e tentar novamente. Sua frase não foi salva em lugar nenhum. Geraremos outra."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt opnieuw beginnen en het nog eens proberen. Je zin is nergens opgeslagen. We genereren een nieuwe."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode recomeçar e tentar novamente. A sua frase não foi guardada em lado nenhum. Vamos gerar outra."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz zacząć od nowa i spróbować ponownie. Twoja fraza nie została nigdzie zapisana. Wygenerujemy inną."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan börja om och försöka igen. Din fras har inte sparats någonstans. Vi skapar en ny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan starte forfra og prøve igen. Din frase er ikke blevet gemt nogen steder. Vi genererer en ny."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan begynne på nytt og prøve igjen. Personvernfrasen din er ikke lagret noe sted. Vi genererer en ny."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit aloittaa alusta ja yrittää uudelleen. Lausekettasi ei ole tallennettu mihinkään. Luomme uuden."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baştan başlayıp tekrar deneyebilirsiniz. İfadeniz hiçbir yere kaydedilmedi. Başka bir tane oluşturacağız."
          }
        }
      }
    },
    "You don't need to choose privacy, it's yours and you never have to ask for it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du musst dich nicht für Privatsphäre entscheiden – sie gehört dir, und du musst nie darum bitten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n'avez pas à choisir la confidentialité : elle vous appartient et vous n'avez jamais à la demander."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tienes que elegir la privacidad: es tuya y nunca tienes que pedirla."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non devi scegliere la privacy: è tua e non devi mai chiederla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não precisa escolher a privacidade, ela é sua e você nunca precisa pedi-la."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hoeft niet voor privacy te kiezen; die is van jou en je hoeft er nooit om te vragen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não tem de escolher a privacidade: é sua e nunca tem de a pedir."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie musisz wybierać prywatności — należy do Ciebie i nigdy nie musisz o nią prosić."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du behöver inte välja integritet – den är din och du ska aldrig behöva be om den."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du behøver ikke vælge privatliv – det er dit, og du behøver aldrig at bede om det."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du trenger ikke å velge personvern. Det er ditt, og du trenger aldri å be om det."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinun ei tarvitse valita yksityisyyttä – se kuuluu sinulle, eikä sinun tarvitse koskaan pyytää sitä."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gizliliği seçmenize gerek yok, o zaten sizindir ve asla talep etmek zorunda kalmazsınız."
          }
        }
      }
    },
