    },
    "The newer version from another device can't be read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die neuere Version von einem anderen Gerät kann nicht gelesen werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version plus récente provenant d'un autre appareil ne peut pas être lue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede leer la versión más reciente de otro dispositivo."
          }
        },
        "it" : {
