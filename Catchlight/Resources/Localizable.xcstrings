    },
    "Encrypted on this device, readable only by you. To finish setting up cloud backup, choose your folder in Settings → System → Cloud Storage." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Gerät verschlüsselt, nur für dich lesbar. Um die Cloud-Sicherung abzuschließen, wähle deinen Ordner unter Einstellungen → System → Cloud-Speicher."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiffré sur cet appareil, lisible uniquement par vous. Pour terminer la configuration de la sauvegarde cloud, choisissez votre dossier dans Réglages → Système → Stockage cloud."
          }
        }
      }
    },
    "Enter your Privacy phrase" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib deine Datenschutz-Phrase ein"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez votre phrase de confidentialité"
          }
        }
      }
    },
    "Enter your Privacy phrase to bring your Takes onto this device. Any Takes stored only on this device will be removed. To keep a copy first, cancel and use Export Takes (Markdown), or make sure they're already in your cloud folder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib deine Datenschutz-Phrase ein, um deine Takes auf dieses Gerät zu holen. Takes, die nur auf diesem Gerät gespeichert sind, werden entfernt. Um vorher eine Kopie zu behalten, brich ab und nutze „Takes exportieren“ (Markdown) oder stelle sicher, dass sie bereits in deinem Cloud-Ordner liegen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez votre phrase de confidentialité pour récupérer vos Takes sur cet appareil. Les Takes stockés uniquement sur cet appareil seront supprimés. Pour en garder une copie d’abord, annulez et utilisez « Exporter les Takes » (Markdown), ou vérifiez qu’ils se trouvent déjà dans votre dossier cloud."
          }
        }
      }
    },
