        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je versleutelde bibliotheek kon niet worden geopend, dus wijzigingen worden nog niet op dit apparaat opgeslagen. Start Catchlight opnieuw."
