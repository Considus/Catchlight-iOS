    "Only syncs when you tap Sync Now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisiert nur, wenn du auf „Jetzt synchronisieren“ tippst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation ne se fait que lorsque vous touchez Synchroniser maintenant."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se sincroniza cuando tocas Sincronizar ahora."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizza solo quando tocchi Sincronizza ora."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só sincroniza quando você toca em Sincronizar agora."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt alleen gesynchroniseerd wanneer je op Nu synchroniseren tikt."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas sincroniza quando toca em Sincronizar agora."
