            "value" : "Behoud deze versie"
          }
        }
      }
    },
    "Keeping it replaces any newer edit that may exist on another device when it syncs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du sie behältst, ersetzt sie beim Synchronisieren alle neueren Änderungen, die es auf einem anderen Gerät geben könnte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La garder remplacera, lors de la synchronisation, toute modification plus récente faite sur un autre appareil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si lo conservas, sustituirá cualquier edición más reciente que pueda haber en otro dispositivo cuando se sincronice."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se la mantieni, durante la sincronizzazione sostituirà qualsiasi modifica più recente presente su un altro dispositivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantê-la substitui, na sincronização, qualquer edição mais recente que possa existir em outro dispositivo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je deze behoudt, vervangt hij bij het synchroniseren elke nieuwere wijziging die mogelijk op een ander apparaat bestaat."
          }
        }
      }
    },
