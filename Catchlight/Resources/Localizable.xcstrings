    "We never see them, store them, or ask for them. So don't lose them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir sehen sie nie, speichern sie nie und fragen nie danach. Also verlier sie nicht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous ne les voyons jamais, ne les stockons jamais et ne vous les demandons jamais. Alors ne les perdez pas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca las vemos, ni las guardamos, ni te las pedimos. Así que no las pierdas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non le vediamo, non le conserviamo e non te le chiediamo mai. Quindi non perderle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nós nunca as vemos, armazenamos ou pedimos. Então não as perca."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We zien ze nooit, bewaren ze nooit en vragen er nooit om. Raak ze dus niet kwijt."
          }
        }
      }
    },
