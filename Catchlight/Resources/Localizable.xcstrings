    "On-device search only. Considus can never read your Takes. Text levels are greyed out by an iOS limitation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suche nur auf dem Gerät. Considus kann deine Takes niemals lesen. Die Textstufen sind wegen einer iOS-Einschränkung ausgegraut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherche sur l’appareil uniquement. Considus ne peut jamais lire vos Takes. Les niveaux de texte sont grisés en raison d’une limite d’iOS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Búsqueda solo en el dispositivo. Considus nunca puede leer tus Takes. Los niveles de texto aparecen atenuados por una limitación de iOS."
