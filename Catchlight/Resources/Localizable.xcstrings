    "Your account is restored on this device. Connect the cloud folder where your Takes are saved and they'll appear here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto wurde auf diesem Gerät wiederhergestellt. Verbinde den Cloud-Ordner, in dem deine Takes gespeichert sind, und sie erscheinen hier."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte est restauré sur cet appareil. Connectez le dossier cloud dans lequel vos Takes sont enregistrés et ils apparaîtront ici."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha restaurado tu cuenta en este dispositivo. Conecta la carpeta de la nube donde están guardados tus Takes y aparecerán aquí."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo account è stato ripristinato su questo dispositivo. Collega la cartella cloud in cui sono salvati i tuoi Take e appariranno qui."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua conta foi restaurada neste dispositivo. Conecte a pasta na nuvem onde seus Takes estão salvos e eles aparecerão aqui."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je account is op dit apparaat hersteld. Koppel de cloudmap waarin je Takes zijn opgeslagen en ze verschijnen hier."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua conta foi restaurada neste dispositivo. Ligue a pasta na nuvem onde os seus Takes estão guardados e estes aparecerão aqui."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje konto zostało przywrócone na tym urządzeniu. Połącz folder w chmurze, w którym zapisane są Twoje Takes, a pojawią się one tutaj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt konto har återställts på den här enheten. Anslut molnmappen där dina Takes sparas, så visas de här."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din konto er gendannet på denne enhed. Opret forbindelse til den cloudmappe, hvor dine Takes er gemt, så vises de her."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontoen din er gjenopprettet på denne enheten. Koble til skymappen der Takes-ene dine er lagret, så vises de her."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilisi on palautettu tälle laitteelle. Yhdistä pilvikansio, johon Takesi on tallennettu, niin ne ilmestyvät tänne."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesabınız bu cihazda geri yüklendi. Take'lerinizin kaydedildiği bulut klasörünü bağlayın, burada görüneceklerdir."
          }
        }
      }
    },
    "Your cloud folder couldn't be opened. Open Settings → Cloud Storage to choose a new one." : {
