          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua biblioteca criptografada não pôde ser aberta, portanto as alterações ainda não estão sendo salvas neste dispositivo. Reinicie o Catchlight."
