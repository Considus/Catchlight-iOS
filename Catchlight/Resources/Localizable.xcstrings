    "When on, a reminder you don't act on nudges again until you mark it done." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn diese Option aktiviert ist, erinnert dich eine unbeachtete Erinnerung erneut, bis du sie als erledigt markierst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque cette option est activée, un rappel que vous n'avez pas traité réapparaît jusqu'à ce que vous le marquiez comme terminé."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando está activado, un recordatorio sobre el que no actúes volverá a avisarte hasta que lo marques como completado."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se attivo, un promemoria che non completi riapparirà finché non lo contrassegni come fatto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, um lembrete que você não atender avisará novamente até que você o marque como concluído."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit is ingeschakeld, wordt een herinnering waarop je niet reageert opnieuw weergegeven totdat je die als voltooid markeert."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, um lembrete não resolvido voltará a avisar até ser marcado como concluído."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy funkcja jest włączona, przypomnienie, na które nie zareagujesz, będzie ponownie przypominać, dopóki nie oznaczysz go jako wykonane."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När det här är aktiverat påminner en påminnelse som du inte agerar på dig igen tills du markerar den som klar."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når aktiveret, vil en påmindelse, du ikke reagerer på, gentage sig, indtil du markerer den som udført."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er på, sender en påminnelse du ikke reagerer på, en ny påminnelse helt til du markerer den som fullført."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun käytössä, muistutus, johon reagoimatta muistutetaan uudelleen, kunnes merkitset sen tehdyksi."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açık olduğunda, işlem yapmadığınız bir anımsatıcı siz onu tamamlandı olarak işaretleyene kadar sizi tekrar dürter."
          }
        }
      }
    },
