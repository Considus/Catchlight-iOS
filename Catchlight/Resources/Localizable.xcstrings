    "On-device search only. Considus can never read your Takes. Text levels are greyed out by an iOS limitation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suche nur auf dem Gerät. Considus kann deine Takes niemals lesen. Die Textebenen sind aufgrund einer iOS-Einschränkung ausgegraut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherche sur l’appareil uniquement. Considus ne peut jamais lire vos Takes. Les niveaux de texte sont grisés en raison d’une limitation d’iOS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Búsqueda solo en el dispositivo. Considus nunca puede leer tus Takes. Los niveles de texto están atenuados debido a una limitación de iOS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricerca solo sul dispositivo. Considus non può mai leggere i tuoi Take. I livelli di testo sono disabilitati a causa di una limitazione di iOS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca apenas no dispositivo. A Considus nunca pode ler seus Takes. Os níveis de texto estão esmaecidos devido a uma limitação do iOS."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen zoeken op dit apparaat. Considus kan je Takes nooit lezen. De tekstniveaus zijn grijs gemaakt vanwege een beperking van iOS."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesquisa apenas no dispositivo. A Considus nunca pode ler os seus Takes. Os níveis de texto estão indisponíveis devido a uma limitação do iOS."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyszukiwanie tylko na urządzeniu. Considus nigdy nie może odczytać Twoich Takes. Poziomy tekstu są wyszarzone z powodu ograniczenia iOS."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sökning endast på enheten. Considus kan aldrig läsa dina Takes. Textnivåerna är nedtonade på grund av en begränsning i iOS."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun søgning på enheden. Considus kan aldrig læse dine Takes. Tekstniveauer vises gråtonet på grund af en begrænsning i iOS."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søk bare på enheten. Considus kan aldri lese Take-ene dine. Tekststørrelsene er nedtonet på grunn av en begrensning i iOS."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain laitteen sisäinen haku. Considus ei voi koskaan lukea Takejasi. Tekstitasot ovat harmaana iOS:n rajoituksen vuoksi."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca cihaz içi arama. Considus Take'lerinizi asla okuyamaz. Metin düzeyleri bir iOS kısıtlaması nedeniyle grileşmiştir."
          }
        }
      }
    },
    "One thing before we continue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch eine Sache, bevor wir fortfahren."
          }
