    "It's in your cloud folder but not on this phone. It didn't pass its check, so it may be an older version." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er liegt in deinem Cloud-Ordner, aber nicht auf diesem iPhone. Er hat die Prüfung nicht bestanden und ist daher möglicherweise eine ältere Version."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il se trouve dans votre dossier cloud mais pas sur cet iPhone. Il n’a pas passé la vérification : il s’agit peut-être d’une version plus ancienne."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está en tu carpeta en la nube, pero no en este iPhone. No ha superado la comprobación, así que puede ser una versión anterior."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si trova nella tua cartella cloud ma non su questo telefono. Non ha superato la verifica, quindi potrebbe essere una versione precedente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele está na sua pasta na nuvem, mas não neste iPhone. Ele não passou na verificação, então pode ser uma versão mais antiga."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hij staat in je cloudmap maar niet op deze telefoon. Hij is niet door de controle gekomen en is mogelijk een oudere versie."
          }
        }
      }
    },
