        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile aprire la tua libreria crittografata, quindi le modifiche non vengono ancora salvate su questo dispositivo. Riavvia Catchlight."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível abrir sua biblioteca criptografada, então as alterações ainda não estão sendo salvas neste dispositivo. Reinicie o Catchlight."
