        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krypterad på den här enheten, läsbar endast för dig. Slutför konfigurationen av molnsäkerhetskopieringen genom att välja din mapp under Inställningar → System → Molnlagring."
          }
        },
        "da" : {
