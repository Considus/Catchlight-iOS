        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka bir cihaz eşitleniyor. Catchlight otomatik olarak tekrar deneyecek."
          }
        }
      }
    },
    "Any items in the folder, that have previously been imported, will be imported again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Elemente im Ordner, die zuvor bereits importiert wurden, werden erneut importiert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les éléments du dossier, déjà importés précédemment, seront importés à nouveau."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier elemento de la carpeta que se haya importado previamente se volverá a importar."
