    "Press and hold an Iris to pin one above the rest. Only one is ever your Obie, because there can only be one that's most important." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte eine Iris gedrückt, um ihren Take über alle anderen zu heften. Es gibt immer nur ein Obie, denn nur eines kann das Wichtigste sein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez le doigt sur un Iris pour épingler son Take au-dessus des autres. Vous n’avez jamais qu’un seul Obie, car un seul peut être le plus important."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado un Iris para fijar ese Take encima del resto. Solo uno puede ser tu Obie, porque solo uno puede ser lo más importante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto un Iris per fissarne il Take sopra tutti gli altri. Il tuo Obie è sempre uno solo, perché solo uno può essere il più importante."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha pressionado um Iris para fixar esse Take acima dos outros. Só um pode ser seu Obie, porque só um pode ser o mais importante."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd een Iris ingedrukt om die Take boven de rest vast te zetten. Er is altijd maar één Obie, want er kan er maar één het belangrijkst zijn."
          }
        }
      }
    },
