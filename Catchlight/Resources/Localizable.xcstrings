          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bestaande Obie keert terug naar de tijdlijn. Slechts één Take kan je Obie zijn."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu Obie atual regressa à cronologia. Só um Take pode ser o seu Obie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój dotychczasowy Obie wraca na linię czasu. Tylko jeden Take może być Twoim Obie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din befintliga Obie visas åter i tidslinjen. Bara en Take kan vara din Obie."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din eksisterende Obie vender tilbage til tidslinjen. Kun én Take kan være din Obie."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din eksisterende Obie vises igjen på tidslinjen. Bare én Take kan være din Obie."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nykyinen Obie palaa aikajanalle. Vain yksi Take voi olla Obie."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mevcut Obie'niz zaman akışına geri döner. Yalnızca bir Take, Obie'niz olabilir."
          }
        }
      }
    },
