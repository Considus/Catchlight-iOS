    "It's in your cloud folder but not on this phone. It didn't pass its check, so it may be an older version." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei befindet sich in deinem Cloud-Ordner, aber nicht auf diesem Telefon. Sie hat die Prüfung nicht bestanden und ist daher möglicherweise eine ältere Version."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier se trouve dans votre dossier cloud, mais pas sur ce téléphone. Il n’a pas passé la vérification ; il s’agit donc peut-être d’une ancienne version."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está en tu carpeta de la nube, pero no en este teléfono. No pasó la comprobación, por lo que puede ser una versión anterior."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si trova nella tua cartella cloud ma non su questo telefono. Non ha superato la verifica, quindi potrebbe essere una versione precedente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está na sua pasta na nuvem, mas não neste telefone. Não passou na verificação, então pode ser uma versão antiga."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het staat in je cloudmap, maar niet op deze telefoon. Het is niet door de controle gekomen en is mogelijk een oudere versie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está na sua pasta na nuvem, mas não neste telemóvel. Não passou na verificação, pelo que poderá ser uma versão mais antiga."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znajduje się w folderze w chmurze, ale nie na tym telefonie. Plik nie przeszedł weryfikacji, więc może to być starsza wersja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den finns i din molnmapp men inte på den här telefonen. Den klarade inte kontrollen, så det kan vara en äldre version."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den ligger i din skymappe, men ikke på denne telefon. Den bestod ikke sin kontrol, så det kan være en ældre version."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den ligger i skymappen din, men ikke på denne telefonen. Den besto ikke kontrollen, så det kan være en eldre versjon."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se on pilvikansiossasi, mutta ei tällä puhelimella. Se ei läpäissyt tarkistusta, joten se saattaa olla vanhempi versio."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bulut klasörünüzde var ama bu telefonda yok. Kontrolü geçemedi, bu nedenle daha eski bir sürüm olabilir."
          }
        }
      }
    },
