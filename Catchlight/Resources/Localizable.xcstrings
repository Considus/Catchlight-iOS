    "We never see them, store them, or ask for them. So don't lose them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir sehen sie nie, speichern sie nicht und fragen auch nicht danach. Verliere sie also nicht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous ne les voyons jamais, ne les stockons pas et ne les demandons jamais. Ne les perdez donc pas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca las vemos, las almacenamos ni las pedimos. Así que no las pierdas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non li vediamo, non li conserviamo e non te li chiediamo. Quindi non perderli."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nós nunca as vemos, armazenamos ou solicitamos. Portanto, não as perca."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We zien ze nooit, slaan ze niet op en vragen er niet om. Raak ze dus niet kwijt."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca as vemos, guardamos ou pedimos. Por isso, não as perca."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nigdy ich nie widzimy, nie przechowujemy ani o nie nie prosimy. Więc ich nie zgub."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi ser dem aldrig, lagrar dem aldrig och ber dig aldrig om dem. Tappa därför inte bort dem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi ser dem aldrig, gemmer dem aldrig eller beder aldrig om dem. Så tab dem ikke."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi ser dem aldri, lagrer dem aldri og ber aldri om dem. Så ikke mist dem."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emme koskaan näe, tallenna tai pyydä niitä. Älä siis menetä niitä."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onları asla görmeyiz, saklamayız veya istemeyiz. Bu yüzden onları kaybetmeyin."
          }
        }
      }
    },
