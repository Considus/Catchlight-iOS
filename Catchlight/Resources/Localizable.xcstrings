    "Terms of Service" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzungsbedingungen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conditions d’utilisation"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condiciones de uso"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termini di servizio"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termos de Serviço"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruiksvoorwaarden"
          }
        }
      }
    },
    "Tested with iCloud Drive, Dropbox, Internxt, Koofr and Filen. Others may work, and a provider that greys out in the picker can't hand an app a whole folder. You'll need its app installed and signed in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Getestet mit iCloud Drive, Dropbox, Internxt, Koofr und Filen. Andere funktionieren eventuell; ein Anbieter, der in der Auswahl ausgegraut ist, kann einer App keinen ganzen Ordner übergeben. Seine App muss installiert und angemeldet sein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testé avec iCloud Drive, Dropbox, Internxt, Koofr et Filen. D’autres peuvent fonctionner ; un service grisé dans le sélecteur ne peut pas confier un dossier entier à une app. Son app doit être installée et connectée."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probado con iCloud Drive, Dropbox, Internxt, Koofr y Filen. Otros pueden funcionar; un proveedor que aparece atenuado en el selector no puede dar a una app acceso a una carpeta entera. Necesitarás su app instalada y con la sesión iniciada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testato con iCloud Drive, Dropbox, Internxt, Koofr e Filen. Altri potrebbero funzionare; un servizio che appare in grigio nel selettore non può fornire a un’app un’intera cartella. Devi avere la sua app installata e aver effettuato l’accesso."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testado com iCloud Drive, Dropbox, Internxt, Koofr e Filen. Outros podem funcionar, e um serviço que aparece em cinza no seletor não consegue entregar uma pasta inteira a um app. O app desse serviço precisa estar instalado e com sessão iniciada."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Getest met iCloud Drive, Dropbox, Internxt, Koofr en Filen. Andere werken misschien ook; een aanbieder die grijs wordt in de kiezer kan geen hele map aan een app geven. De app van de aanbieder moet geïnstalleerd zijn en je moet erin zijn ingelogd."
          }
        }
      }
    },
    "That doesn't look right. Check the words and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das stimmt nicht ganz. Prüfe die Wörter und versuche es erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce n’est pas tout à fait ça. Vérifiez les mots et réessayez."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo no cuadra. Revisa las palabras e inténtalo de nuevo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualcosa non torna. Controlla le parole e riprova."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo não está certo. Confira as palavras e tente novamente."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dat lijkt niet te kloppen. Controleer de woorden en probeer het opnieuw."
          }
        }
      }
    },
    "The 12 words from your other device, in order." : {
      "localizations" : {
