        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem geri alınamaz."
          }
        }
      }
    },
    "This deletes every Take on this device and the Privacy phrase that unlocks them. Takes in your cloud folder will be unreadable. This cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle Takes auf diesem Gerät und die Datenschutz-Phrase, mit der sie entsperrt werden, gelöscht. Takes in deinem Cloud-Ordner sind dann nicht mehr lesbar. Das kann nicht rückgängig gemacht werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime tous les Takes sur cet appareil ainsi que la phrase de confidentialité qui les déverrouille. Les Takes dans votre dossier cloud seront illisibles. Cette action est irréversible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará todos los Takes de este dispositivo y la frase de privacidad que los desbloquea. Los Takes de tu carpeta de la nube dejarán de ser legibles. Esto no se puede deshacer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa operazione elimina tutti i Take su questo dispositivo e la frase Privacy che li sblocca. I Take nella cartella cloud non saranno leggibili. Non è possibile annullare questa operazione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso exclui todos os Takes neste dispositivo e a Frase de privacidade que os desbloqueia. Os Takes na sua pasta na nuvem não poderão ser lidos. Isso não pode ser desfeito."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee verwijder je alle Takes op dit apparaat en de privacyzin waarmee je ze ontgrendelt. Takes in je cloudmap worden onleesbaar. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto elimina todos os Takes neste dispositivo e a frase de privacidade que os desbloqueia. Os Takes na sua pasta na nuvem ficarão ilegíveis. Esta ação não pode ser desfeita."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to usunięcie każdego Take na tym urządzeniu oraz frazy prywatności, która je odblokowuje. Takes w Twoim folderze w chmurze staną się nieczytelne. Tej czynności nie można cofnąć."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här raderar alla Takes på den här enheten och integritetsfrasen som låser upp dem. Takes i din molnmapp blir oläsbara. Det går inte att ångra."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette sletter alle Takes på denne enhed og den privatfrase, der låser dem op. Takes i din skymappe bliver ulæselige. Dette kan ikke fortrydes."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette sletter alle Take-er på denne enheten og personvernfrasen som låser dem opp. Take-ene i skymappen din blir uleselige. Dette kan ikke angres."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä poistaa jokaisen Taken tältä laitteelta ja yksityisyysfraasin, joka avaa ne. Pilvikansiossasi olevat Taket muuttuvat lukukelvottomiksi. Tätä ei voi peruuttaa."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem, bu cihazdaki tüm Take'leri ve bunların kilidini açan Gizlilik ifadesini siler. Bulut klasörünüzdeki Take'ler okunamaz hale gelir. Bu işlem geri alınamaz."
          }
        }
      }
    },
