    "Authenticate to open your Takes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authentifiziere dich, um deine Takes zu öffnen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authentifiez-vous pour ouvrir vos Takes."
          }
        },
        "es" : {
