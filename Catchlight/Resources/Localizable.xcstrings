          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tego działania nie można cofnąć."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det går inte att ångra."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
