          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez les mots de votre phrase, dans l’ordre."
          }
        }
      }
    },
    "Tap words %lld, %lld and %lld from your phrase, in order." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tap words %1$lld, %2$lld and %3$lld from your phrase, in order."
