    "Your encrypted library couldn't be opened, so changes aren't being saved to this device yet. Please restart Catchlight." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine verschlüsselte Mediathek konnte nicht geöffnet werden. Änderungen werden daher vorerst nicht auf diesem Gerät gespeichert. Bitte starte Catchlight neu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d'ouvrir votre bibliothèque chiffrée, les modifications ne sont donc pas encore enregistrées sur cet appareil. Veuillez redémarrer Catchlight."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo abrir tu biblioteca cifrada, por lo que los cambios aún no se están guardando en este dispositivo. Reinicia Catchlight."
