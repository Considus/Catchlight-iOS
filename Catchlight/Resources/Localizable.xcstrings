    "Catchlight never sees your files. Only you can read them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight sieht deine Dateien nie. Nur du kannst sie lesen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight ne voit jamais vos fichiers. Ils ne sont lisibles que par vous."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight nunca ve tus archivos. Solo tú puedes leerlos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight non vede mai i tuoi file. Solo tu puoi leggerli."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Catchlight nunca vê seus arquivos. Só você pode lê-los."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight ziet je bestanden nooit. Alleen jij kunt ze lezen."
          }
        }
      }
    },
    "Catchlight stores the Privacy phrase only on the device where you set it up. If you onboarded on a different device, use that one to view it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight speichert die Datenschutz-Phrase nur auf dem Gerät, auf dem du sie eingerichtet hast. Hast du Catchlight auf einem anderen Gerät eingerichtet, sieh sie dir dort an."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight conserve la phrase de confidentialité uniquement sur l’appareil où vous l’avez configurée. Si vous avez démarré sur un autre appareil, affichez-la sur celui-ci."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight guarda la frase de privacidad solo en el dispositivo donde la configuraste. Si empezaste en otro dispositivo, usa ese para verla."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight conserva la frase di privacy solo sul dispositivo su cui l’hai configurata. Se hai iniziato su un altro dispositivo, usa quello per vederla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Catchlight guarda a frase de privacidade apenas no dispositivo em que você a configurou. Se você fez a configuração inicial em outro dispositivo, use esse dispositivo para vê-la."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight bewaart de privacyzin alleen op het apparaat waarop je hem hebt ingesteld. Ben je op een ander apparaat begonnen, bekijk hem dan daar."
          }
        }
      }
    },
    "Catchlight uses only Apple system frameworks (CryptoKit, LocalAuthentication, Security, SQLite3). No third-party libraries are bundled." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight verwendet nur Apple-Systemframeworks (CryptoKit, LocalAuthentication, Security, SQLite3). Bibliotheken von Drittanbietern sind nicht enthalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight utilise uniquement des frameworks système d’Apple (CryptoKit, LocalAuthentication, Security, SQLite3). Aucune bibliothèque tierce n’est incluse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight solo usa frameworks del sistema de Apple (CryptoKit, LocalAuthentication, Security, SQLite3). No incluye bibliotecas de terceros."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight usa solo framework di sistema Apple (CryptoKit, LocalAuthentication, Security, SQLite3). Non include librerie di terze parti."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Catchlight usa apenas frameworks do sistema da Apple (CryptoKit, LocalAuthentication, Security, SQLite3). Nenhuma biblioteca de terceiros é incluída."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight gebruikt alleen systeemframeworks van Apple (CryptoKit, LocalAuthentication, Security, SQLite3). Er zijn geen bibliotheken van derden meegeleverd."
          }
        }
      }
    },
    "Catchlight: %@" : {
      "localizations" : {
