    "Double-tap Add Take in the toolbar. To save, double-tap Save and close. That's the whole capture flow." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe in der Symbolleiste doppelt auf „Take hinzufügen“. Zum Speichern tippst du doppelt auf „Sichern und schließen“. Mehr ist zum Erfassen nicht nötig."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez deux fois « Ajouter un Take » dans la barre d’outils. Pour enregistrer, touchez deux fois « Enregistrer et fermer ». C’est tout pour capturer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dos veces “Añadir Take” en la barra de herramientas. Para guardar, toca dos veces “Guardar y cerrar”. Así de fácil es capturar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca due volte “Aggiungi Take” nella barra strumenti. Per salvare, tocca due volte “Salva e chiudi”. Tutto qui."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque duas vezes em “Adicionar Take” na barra de ferramentas. Para salvar, toque duas vezes em “Salvar e fechar”. Capturar é só isso."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik twee keer op ‘Voeg Take toe’ in de knoppenbalk. Tik twee keer op ‘Bewaar en sluit’ om te bewaren. Meer is vastleggen niet."
          }
        }
      }
    },
