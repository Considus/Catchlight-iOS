    "A tighter radius is more precise, but iOS may trigger it late or miss it. 100 m is the reliable minimum." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein kleinerer Radius ist genauer, aber iOS löst ihn eventuell zu spät oder gar nicht aus. 100 m sind das zuverlässige Minimum."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rayon plus petit est plus précis, mais iOS peut le déclencher en retard ou pas du tout. 100 m est le minimum fiable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un radio más pequeño es más preciso, pero iOS puede activarlo tarde o no activarlo. 100 m es el mínimo fiable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un raggio più stretto è più preciso, ma iOS potrebbe attivarlo in ritardo o non attivarlo affatto. 100 m è il minimo affidabile."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um raio menor é mais preciso, mas o iOS pode acioná-lo com atraso ou nem acioná-lo. 100 m é o mínimo confiável."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een kleinere straal is nauwkeuriger, maar iOS kan hem te laat of helemaal niet activeren. 100 m is het betrouwbare minimum."
          }
        }
      }
    },
