    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Catchlight uses Face ID to unlock your encrypted Takes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight nutzt Face ID, um deine verschlüsselten Takes zu entsperren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight utilise Face ID pour déverrouiller vos Takes chiffrés."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight usa Face ID para desbloquear tus Takes cifrados."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight utilizza Face ID per sbloccare i tuoi Take crittografati."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Catchlight usa o Face ID para desbloquear seus Takes criptografados."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight gebruikt Face ID om je versleutelde Takes te ontgrendelen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Catchlight usa o Face ID para desbloquear os seus Takes encriptados."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight używa Face ID do odblokowania zaszyfrowanych Takes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight använder Face ID för att låsa upp dina krypterade Takes."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight bruger Face ID til at låse dine krypterede Takes op."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight bruker Face ID til å låse opp de krypterte Take-ene dine."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight käyttää Face ID:tä salattujen Takejesi avaamiseen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight, şifrelenmiş Take'lerinizin kilidini açmak için Face ID kullanır."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlightは、暗号化されたTakeのロックを解除するためにFace IDを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight는 암호화된 Take를 잠금 해제하기 위해 Face ID를 사용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight 使用面容 ID 解锁已加密的 Takes。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight 使用 Face ID 解鎖您已加密的 Takes。"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight ใช้ Face ID เพื่อปลดล็อก Take ที่เข้ารหัสของคุณ"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Catchlight uses your location to remind you about a Take when you arrive at or leave a place."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight nutzt deinen Standort, um dich an einen Take zu erinnern, wenn du an einem Ort ankommst oder ihn verlässt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight utilise votre position pour vous rappeler un Take lorsque vous arrivez à un endroit ou le quittez."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight usa tu ubicación para recordarte sobre un Take cuando llegues o salgas de un lugar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight utilizza la tua posizione per ricordarti di un Take quando arrivi in un luogo o lo lasci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Catchlight usa sua localização para lembrar você de um Take quando chegar ou sair de um lugar."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight gebruikt je locatie om je aan een Take te herinneren wanneer je ergens aankomt of vertrekt."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Catchlight usa a sua localização para o lembrar de um Take quando chegar ou sair de um local."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight używa Twojej lokalizacji, aby przypomnieć Ci o Take, gdy przybędziesz do miejsca lub je opuścisz."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight använder din plats för att påminna dig om en Take när du kommer till eller lämnar en plats."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight bruger din lokalitet til at minde dig om en Take, når du ankommer til eller forlader et sted."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight bruker posisjonen din til å minne deg på en Take når du ankommer eller forlater et sted."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight käyttää sijaintiasi muistuttaakseen sinua Take:sta, kun saavut paikkaan tai lähdet sieltä."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight, bir yere vardığınızda veya bir yerden ayrıldığınızda bir Take'i size hatırlatmak için konumunuzu kullanır."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlightは、特定の場所に到着したときや出発したときにTakeについて通知するために、位置情報を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight는 장소에 도착하거나 떠날 때 Take에 대해 알려 드리기 위해 위치를 사용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当您到达或离开某个地点时，Catchlight 会根据您的位置提醒您查看 Take。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight 會使用您的位置，在您抵達或離開某處時提醒您查看 Take。"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight ใช้ตำแหน่งที่ตั้งของคุณเพื่อเตือนเกี่ยวกับ Take เมื่อคุณไปถึงหรือออกจากสถานที่"
          }
        }
      }
    }
  },
  "version" : "1.0"
}