    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Catchlight uses Face ID to unlock your encrypted Takes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight verwendet Face ID, um deine verschlüsselten Takes zu entsperren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight utilise Face ID pour déverrouiller vos Takes chiffrés."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight usa Face ID para desbloquear tus Takes cifrados."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight usa Face ID per sbloccare i tuoi Take crittografati."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Catchlight usa o Face ID para desbloquear seus Takes criptografados."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight gebruikt Face ID om je versleutelde Takes te ontgrendelen."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Catchlight uses your location to remind you about a Take when you arrive at or leave a place."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight verwendet deinen Standort, um dich an einen Take zu erinnern, wenn du an einem Ort ankommst oder ihn verlässt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight utilise votre position pour vous rappeler un Take quand vous arrivez dans un lieu ou le quittez."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight usa tu ubicación para recordarte un Take cuando llegas a un lugar o sales de él."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight usa la tua posizione per ricordarti un Take quando arrivi in un luogo o te ne vai."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Catchlight usa sua localização para lembrar você de um Take quando você chegar a um local ou sair dele."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight gebruikt je locatie om je aan een Take te herinneren wanneer je op een plek aankomt of er vertrekt."
          }
        }
      }
    }
  },
  "version" : "1.0"
