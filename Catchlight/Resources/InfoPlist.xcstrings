    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Catchlight uses Face ID to unlock your encrypted Takes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight verwendet Face ID, um deine verschlüsselten Takes zu entsperren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight utilise Face ID pour déverrouiller vos Takes chiffrés."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Catchlight uses your location to remind you about a Take when you arrive at or leave a place."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight verwendet deinen Standort, um dich an einen Take zu erinnern, wenn du an einem Ort ankommst oder ihn verlässt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight utilise votre position pour vous rappeler un Take quand vous arrivez dans un lieu ou le quittez."
          }
        }
      }
    }
