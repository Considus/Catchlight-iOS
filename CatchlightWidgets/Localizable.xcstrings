        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide opnameknoppen in één widget — tik op de kant die je nodig hebt."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
