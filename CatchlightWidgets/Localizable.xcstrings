    "Both capture buttons in one widget — tap the side you need." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide Aufnahmetasten in einem Widget — tippe auf die Seite, die du brauchst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les deux boutons de capture dans un seul widget : appuyez sur celui dont vous avez besoin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los dos botones de captura en un solo widget: toca el lado que necesites."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrambi i pulsanti di acquisizione in un unico widget: tocca il lato che ti serve."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
