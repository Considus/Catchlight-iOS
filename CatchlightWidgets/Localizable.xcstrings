    "Open Catchlight and capture your Obie." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne Catchlight und halte deine Obie fest."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez Catchlight et capturez votre Obie."
          }
        },
