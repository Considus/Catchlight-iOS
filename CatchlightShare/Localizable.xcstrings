    "It takes text, links and web pages, not images or files." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es nimmt Text, Links und Webseiten an, keine Bilder oder Dateien."
          }
        },
        "fr" : {
          "stringUnit" : {
