    "It takes text, links and web pages, not images or files." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst Text, Links und Webseiten hinzufügen, aber keine Bilder oder Dateien."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez partager du texte, des liens et des pages web, mais pas des images ni des fichiers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Admite texto, enlaces y páginas web, pero no imágenes ni archivos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi acquisire testo, link e pagine web, ma non immagini o file."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceita textos, links e páginas da web, não imagens ou arquivos."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt tekst, links en webpagina's toevoegen, maar geen afbeeldingen of bestanden."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceita texto, ligações e páginas Web, mas não imagens nem ficheiros."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przyjmuje tekst, linki i strony internetowe, a nie obrazy czy pliki."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan spara text, länkar och webbsidor, men inte bilder eller filer."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den kan hente tekst, links og websider, men ikke billeder eller filer."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan hente inn tekst, lenker og nettsider, men ikke bilder eller filer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit tuoda tekstiä, linkkejä ja verkkosivuja, mutta et kuvia tai tiedostoja."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görselleri veya dosyaları değil; metinleri, bağlantıları ve web sayfalarını kabul eder."
          }
        }
      }
    },
    "It'll be waiting on your timeline next time you open the app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim nächsten Öffnen der App wartet sie auf deiner Timeline auf dich."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre note vous attendra dans votre fil la prochaine fois que vous ouvrirez l’app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estará esperando en tu cronología la próxima vez que abras la aplicación."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
